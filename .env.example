# Copy this file to .env and fill in your keys (never commit .env)
# Local self-hosted Hindsight (default). For Hindsight Cloud use https://api.hindsight.vectorize.io + your hsk_ key.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=local
HINDSIGHT_BANK_ID=dga-historian-v2
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
